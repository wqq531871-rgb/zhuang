# local

# Portable delivery / local env (do not commit)
PackingPortable/
.conda/
.venv/
venv/

# PyInstaller release / build artifacts (too large for GitHub)
release/
packing-system/packaging/build_work/
packing-system/packaging/*.log
packing-system/packaging/_detached_build.ps1

# packing-robot runtime / cache
packing-robot/__pycache__/
packing-robot/**/__pycache__/
packing-robot/.pytest_cache/
packing-robot/robot_actions_*.json

# Local isolated development worktrees
.worktrees/

# Python caches
__pycache__/
**/__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Runtime workspace (regenerated by UI / WCS; keep sample Excel under data/)
packing-workspace/output/
packing-workspace/input/
packing-workspace/runtime/
packing-workspace/data/ui_inputs/
packing-workspace/**/*.log

# Archives / installers accidentally dropped in-tree
*.zip
*.rar
*.7z
*.exe

# Misc local junk
*.tmp
*.bak
*.log
.DS_Store
Thumbs.db
desktop.ini
.env
.env.*
